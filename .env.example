# Copia este archivo como ".env.local" (junto al package.json) para cambiar la configuración en tu PC.
# Vite solo lee variables que empiezan con VITE_ y las incluye en el build.

# URL del API Gateway.
#   Desarrollo local (valor por defecto si no existe):  http://localhost:8080
#   AWS: la URL del Gateway en el EC2 (ya está en .env.production)
VITE_API_URL=http://localhost:8080

# false (por defecto): la tienda funciona sola con localStorage.
# true: usuarios con JWT, catálogo e imágenes en el servidor (necesita el backend levantado).
# El build de producción ya trae true (ver .env.production).
VITE_MODO_SERVIDOR=false
