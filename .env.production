# Se usa automáticamente en "npm run build" (el build que se sube a AWS). No contiene secretos: las variables VITE_* son públicas.

# API Gateway en el EC2 (Elastic IP fija). El front está en S3 como sitio web: el Learner Lab no permite CloudFront.
VITE_API_URL=http://ec2-100-61-236-90.compute-1.amazonaws.com:8080

# Usuarios con JWT y catálogo en el servidor (en vez de solo localStorage)
VITE_MODO_SERVIDOR=true
