# Variables de entorno de TODOS los servicios en el EC2 (se instala en /etc/papita/papita.env, permisos 640).
# Formato systemd: una variable por línea, SIN comillas y SIN "export".
# ec2-install.sh completa solo JWT_SECRET y DB_PASSWORD la primera vez. Tú completas SPOONACULAR_API_KEY y FRONTEND_URL.

# ---- Base de datos: MySQL en el mismo EC2 ----
DB_USER=papita
DB_PASSWORD=
USUARIO_DB_URL=jdbc:mysql://localhost:3306/db_papita_usuarios?useSSL=false&allowPublicKeyRetrieval=true
CATALOGO_DB_URL=jdbc:mysql://localhost:3306/db_catalogo?useSSL=false&allowPublicKeyRetrieval=true
ORDEN_DB_URL=jdbc:mysql://localhost:3306/db_papita_ordenes?useSSL=false&allowPublicKeyRetrieval=true
NUTRICION_DB_URL=jdbc:mysql://localhost:3306/db_nutricion?useSSL=false&allowPublicKeyRetrieval=true

# ---- Seguridad ----
# Base64 de al menos 32 bytes; el mismo para usuario-service y el Gateway
JWT_SECRET=

# ---- API externa ----
SPOONACULAR_API_KEY=

# ---- Front ----
# URL del bucket S3 (sitio web), sin barra final. Se usa para CORS
FRONTEND_URL=http://papita-dulce-front-1795462752.s3-website-us-east-1.amazonaws.com

# ---- Fotos de productos (carpeta media) ----
MEDIA_DIR=/var/lib/papita/media

# ---- Eureka: todo corre en la misma máquina ----
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
