[Unit]
Description=Papita Dulce - eureka-server (registro de servicios)
After=network.target mysql.service
Wants=network.target

[Service]
User=papita
Group=papita
WorkingDirectory=/opt/papita
EnvironmentFile=/etc/papita/papita.env
# Solo escucha dentro de la máquina: nadie puede saltarse el Gateway
Environment=SERVER_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -Xms128m -Xmx192m -jar /opt/papita/eureka-server.jar
# Spring Boot termina con código 143 al recibir SIGTERM: es una parada normal
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
